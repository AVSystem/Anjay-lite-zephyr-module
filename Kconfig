menu "Anjay Lite LwM2M libary"

config ANJAY_LITE_ZEPHYR
    bool "Anjay Lite LwM2M library support"

if ANJAY_LITE_ZEPHYR

menuconfig ANJAY_LITE_ZEPHYR_COMPAT_LOG_DEFAULT
    bool "Enable default compat of logging API for Anjay Lite"
    default y
    depends on LOG

    module = ANJAY_LITE_ZEPHYR
    module-str = Log level for Anjay Lite
    source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

config ANJAY_LITE_ZEPHYR_COMPAT_RNG_DEFAULT
    bool "Enable default compat of RNG for Anjay Lite"
    default y

config ANJAY_LITE_ZEPHYR_COMPAT_MBEDTLS_TIMING_ALT_DEFAULT
    bool "Enable default compat of MbedTLS timing alt for Anjay Lite"
    default y

endif

endmenu
